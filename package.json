{
  "name": "fournee",
  "version": "0.1.0",
  "private": true,
  "description": "Fournée : application web de batch cooking, locale d'abord",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "apercu": "vite preview --port 4182 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit -p tsconfig.json",
    "validate:html": "html-validate index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run types && npm run validate:html && npm run test",
    "test:e2e": "npm run build && playwright test",
    "budget": "node outils/budget.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check",
    "pre-push": "npm run test:e2e && npm run budget"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@babel/core": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "darkreader": "^4.9.135",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.22.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1"
  }
}
